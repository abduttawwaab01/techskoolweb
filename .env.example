# Neon PostgreSQL connection string (SSL is required by Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require

# Secret used to sign the session cookie. Use a long random string in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@techskool.com
ADMIN_PASSWORD=techskool123
ADMIN_DISPLAY_NAME=Techskool Admin

# Server
PORT=3000
NODE_ENV=development
